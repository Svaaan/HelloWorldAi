COORDINATOR_BASE=http://127.0.0.1:8100
NODE_BASE=http://127.0.0.1:9100

# Secret used by the coordinator to sign node session tokens.
# If unset, an ephemeral key is generated at startup: every node session is
# invalidated on restart and tokens will not validate across multiple workers.
# Generate one with: python -c "import secrets;print(secrets.token_urlsafe(32))"
NODE_TOKEN_SECRET=
# How long a node session token stays valid, in seconds (default 86400 = 24h)
NODE_TOKEN_TTL=86400

# How often a node reports in to the coordinator, in seconds.
# Must stay well under the coordinator's 5-minute stale-node threshold.
HEARTBEAT_INTERVAL=60
