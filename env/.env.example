# Copy to env/.env.production (central server) or env/.env.test (local) and
# fill in the secrets. This file is committed; the copies are not.
#
# Generate every secret below on the machine that will use it, and do not reuse
# one across environments.

ENV=production
USE_DOCKER=true

# --- addresses -----------------------------------------------------------

COORDINATOR_BASE=http://127.0.0.1:8100
NODE_BASE=http://127.0.0.1:9100

DASHBOARD_PORT=3000
COORDINATOR_PORT=8100
NODE_PORT=9100

# Where the compose stack publishes its ports. The default keeps both services
# on the loopback interface so a reverse proxy can terminate TLS in front of
# them. Set to 0.0.0.0 only if you accept serving plain HTTP to the internet.
BIND_ADDRESS=127.0.0.1

# --- database ------------------------------------------------------------

# Left unset, the compose stack points this at its own mongo service. Set it to
# reach a managed database instead.
# MONGO_URI=mongodb://user:password@host:27017/HelloWorldAi

# --- secrets -------------------------------------------------------------

# Signs the session tokens a node uses to prove which machine it is.
# Unset, an ephemeral key is generated at startup: every node session breaks on
# restart, and tokens will not validate across multiple workers.
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
NODE_TOKEN_SECRET=

# How long a node session token stays valid, in seconds (86400 = 24h).
NODE_TOKEN_TTL=86400

# Encrypts submitted datasets before they are written to the database, so a
# dump or a backup does not hand over everyone's training data. Unset, datasets
# are stored in the clear and the coordinator says so in its log at startup.
#
# This does NOT hide data from the contributor running the job -- a GPU has to
# see the numbers to train on them. It protects stored data, nothing more.
#
# Keep it somewhere you will not lose it: encrypted datasets cannot be read
# back without it, and there is no recovery path.
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
ARTIFACT_ENCRYPTION_KEY=

# --- behaviour -----------------------------------------------------------

# How often a node reports in, in seconds. Must stay well under the
# coordinator's 5-minute stale-node threshold.
HEARTBEAT_INTERVAL=60

# How often an idle node asks for work, in seconds.
TASK_POLL_INTERVAL=10

# How long a finished job's dataset is kept before it is deleted. Long enough
# for verification to run and for a retry to reuse the same split.
DATASET_RETENTION_MINUTES=60

# Fraction of a submitted dataset withheld from the node, used to check that
# the model it returns actually learned something.
HOLDOUT_FRACTION=0.2
