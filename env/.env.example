# Copy to env/.env.production (central server) or env/.env.test (local) and
# fill in the secrets. This file is committed; the copies are not.
#
# Generate every secret below on the machine that will use it, and do not reuse
# one across environments.

ENV=production
USE_DOCKER=true

# --- addresses -----------------------------------------------------------

COORDINATOR_BASE=http://127.0.0.1:8100
NODE_BASE=http://127.0.0.1:9100

DASHBOARD_PORT=3000
COORDINATOR_PORT=8100
NODE_PORT=9100

# Where the compose stack publishes its ports. The default keeps both services
# on the loopback interface so a reverse proxy can terminate TLS in front of
# them. Set to 0.0.0.0 only if you accept serving plain HTTP to the internet.
BIND_ADDRESS=127.0.0.1

# --- database ------------------------------------------------------------

# Left unset, the compose stack points this at its own mongo service. Set it to
# reach a managed database instead.
# MONGO_URI=mongodb://user:password@host:27017/HelloWorldAi
#
# Which database on that server. Development and production are separated by
# this and nothing else, so set it deliberately. It was once the literal
# "NodeDbTest" in the source, which sent production writes to a database
# named Test.
MONGO_DB=NodeDbProd

# --- secrets -------------------------------------------------------------

# Signs the session tokens a node uses to prove which machine it is.
# Unset, an ephemeral key is generated at startup: every node session breaks on
# restart, and tokens will not validate across multiple workers.
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
NODE_TOKEN_SECRET=

# How long a node session token stays valid, in seconds (86400 = 24h).
NODE_TOKEN_TTL=86400

# Optional. The service runs either way, and an empty value is a working
# configuration rather than a missing key -- if you have never set one there is
# nothing to recover and nothing to go looking for.
#
# Set, it encrypts submitted datasets before they are written to the database,
# so a dump or a backup does not hand over everyone's training data. Unset,
# datasets are stored in the clear, the coordinator says so in its log at
# startup, and the send-work page tells submitters that rather than claiming
# a protection that is not there.
#
# This does NOT hide data from the contributor running the job -- a GPU has to
# see the numbers to train on them. It protects stored data, nothing more.
#
# If you do set one, keep it somewhere you will not lose it: encrypted datasets
# cannot be read back without it, and there is no recovery path.
#   python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
ARTIFACT_ENCRYPTION_KEY=

# --- signing in with GitHub (optional) -----------------------------------
#
# Leave both blank and the service works exactly as it always has: the key in
# somebody's browser is their identity, and the workspace hides the sign-in
# panel rather than offering a button that leads to an error.
#
# Filled in, people can sign in with GitHub. What that buys them is that their
# work has an owner: the jobs sent from a desktop show up on a laptop, and a
# list of GPUs worth going back to has something to hang off.
#
# It does NOT put a key in this database. The coordinator stores sha256(key)
# and cannot do anything with it, which is the property worth keeping -- so an
# account links to those digests instead. Nobody's key is recoverable from
# here, signed in or not, and that is on purpose.
#
# Register an OAuth application at https://github.com/settings/developers with
#   Homepage URL:  https://your.domain
#   Redirect URI:  https://your.domain/auth/github/callback
# and wildcard matching and device flow both off. GitHub compares that redirect
# URI character for character. There is no scopes field on the form -- the
# sign-in asks for none, so only the username is ever read.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# The address a browser actually reaches this service on, with no trailing
# slash. Needed only for sign-in, and not guessable from inside: the coordinator
# sits behind the dashboard proxy behind Caddy, so the address it sees is
# http://coordinator:8100 -- a name that exists only on the compose network.
# Sending GitHub back to that produces a callback the browser cannot follow.
#   PUBLIC_URL=https://your.domain
PUBLIC_URL=

# How long a sign-in lasts, in seconds (2592000 = 30 days).
SESSION_TTL_SECONDS=2592000

# --- behaviour -----------------------------------------------------------

# How often a node reports in, in seconds. Must stay well under the
# coordinator's 5-minute stale-node threshold.
HEARTBEAT_INTERVAL=60

# How often an idle node asks for work, in seconds.
TASK_POLL_INTERVAL=10

# How long a finished job's dataset is kept before it is deleted.
#
# The first is for an anonymous submitter: long enough for verification to run
# and for an immediate retry to reuse the same split, which is all it can be.
# The key that owns the job may already be gone from the browser that made it,
# so there is nobody to keep it for.
#
# The second is for somebody signed in. They have a workspace to manage this
# from and can come back to it, and "adjust and run" -- training the same data
# again with different settings, against the same withheld rows -- is the whole
# reason the data is worth keeping. An hour is not long enough to have an idea
# overnight, and people were re-uploading the same file because of it.
DATASET_RETENTION_MINUTES=60
DATASET_RETENTION_ACCOUNT_MINUTES=10080

# How many of one owner's finished jobs hold their data at once. Past this the
# oldest are dropped early, whatever the clock says -- storage is real, and an
# account that keeps everything forever is a bill rather than a feature.
DATASET_KEEP_PER_OWNER=10

# The most retained dataset and holdout data this deployment will hold across
# everybody, in bytes. 8 GB by default, for a machine with a 38 GB disk that is
# also carrying MongoDB, four containers and the operating system.
#
# The per-owner cap above bounds one person and bounds nothing in total: five
# hundred people keeping ten datasets each is five thousand datasets. Past this
# ceiling the oldest data is dropped early whatever the clock promised, because
# a service that keeps data for a week and then fills its disk is worse than
# one that keeps it for a day and stays up. It is logged at warning level when
# it happens.
#
# Trained weights are not counted: the sweep never deletes them, so counting
# them would leave it over the line with nothing it is willing to drop.
#
# Set to 0 to turn the ceiling off, on a deployment with real storage behind it.
DATASET_STORAGE_CEILING_BYTES=8589934592

# When the ceiling is hit, clear down to this fraction of it rather than just
# under -- otherwise the next upload trips it again and every pass deletes.
DATASET_RECLAIM_TO=0.9

# Fraction of a submitted dataset withheld from the node, used to check that
# the model it returns actually learned something.
HOLDOUT_FRACTION=0.2
