# ─── Python ─────────────────────────────────────────────────────────────
*.pyc
*.pyo
*.pyd
__pycache__/

# ─── Virtual Environments ───────────────────────────────────────────────
venv/
.venv/

# ─── Git & VCS ──────────────────────────────────────────────────────────
.git/

# ─── Editors / IDEs ─────────────────────────────────────────────────────
.vscode/
.idea/

# ─── OS / System Files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db
docker/data/**


# ─── Environment Variables ──────────────────────────────────────────────
env/.env
env/.env.local
env/.env.test
env/.env.production


!env/.env.example

# ─── Docker stuff (optional, but good practice) ─────────────────────────
*.log
docker-compose.override.yml
*.pid

# If you moved docker-compose files to /docker
docker/docker-compose.override.yml

# ─── Keep Source Folder ─────────────────────────────────────────────────
!src/
!src/**/*

# ...but not the caches Python drops there. The rule above re-includes
# everything under src/, which quietly overrode the __pycache__ rule at the top
# of this file -- gitignore takes the last match, not the most specific one.
# That is how twenty-six .pyc files came to be committed, and why a local test
# run used to leave the working tree dirty.
src/**/__pycache__/

# Backups. backup.sh refuses to write inside the repo and defaults outside it,
# but a copy dragged in here by hand would carry NODE_TOKEN_SECRET and the
# artifact encryption key in the clear.
*.archive.gz
env.production
helloworldai-backups/
