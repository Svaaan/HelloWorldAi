# ─── Python ─────────────────────────────────────────────────────────────
*.pyc
*.pyo
*.pyd
__pycache__/

# ─── Virtual Environments ───────────────────────────────────────────────
venv/
.venv/

# ─── Git & VCS ──────────────────────────────────────────────────────────
.git/

# ─── Editors / IDEs ─────────────────────────────────────────────────────
.vscode/
.idea/

# ─── OS / System Files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Environment Variables ──────────────────────────────────────────────
env/*
!env/.env.example
!env/.env.local
!env/.env.production
!env/.env.*
!env/.env.development
!env/.gitkeep

# ✅ Keep example file
!.env.example

# ─── Docker stuff (optional, but good practice) ─────────────────────────
*.log
docker-compose.override.yml
*.pid

# ─── Keep Source Folder ─────────────────────────────────────────────────
!src/
!src/**/*
