# ─── Python ─────────────────────────────────────────────────────────────
*.pyc
*.pyo
*.pyd
__pycache__/

# ─── Virtual Environments ───────────────────────────────────────────────
venv/
.venv/

# ─── Git & VCS ──────────────────────────────────────────────────────────
.git/

# ─── Editors / IDEs ─────────────────────────────────────────────────────
.vscode/
.idea/

# ─── OS / System Files ──────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ─── Environment Variables ──────────────────────────────────────────────
env/.env
env/.env.local
env/.env.test
env/.env.production

# ✅ Keep example file
!env/.env.example

# ─── Docker stuff (optional, but good practice) ─────────────────────────
*.log
docker-compose.override.yml
*.pid

# If you moved docker-compose files to /docker
docker/docker-compose.override.yml

# ─── Keep Source Folder ─────────────────────────────────────────────────
!src/
!src/**/*
